@model List<Doctor>

<div class="page-bg">
    <div class="container">

        <h2 class="mb-4">Our Doctors</h2>

       
        <form method="get" class="row g-2 mb-4">
            <div class="col-md-4">
                <input type="text" name="name" value="@ViewBag.Name"
                       class="form-control" placeholder="Search by doctor name..." />
            </div>
            <div class="col-md-4">
                <select name="specialization" class="form-select">
                    <option value="">All Specializations</option>
                    @foreach (var s in (List<string>)ViewBag.Specializations)
                    {
                        <option value="@s" selected="@(s == (string?)ViewBag.Specialization)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-light">Reset</a>
            </div>
        </form>

     
        <div class="row">
            @foreach (var d in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 text-center shadow-sm">
                        <img src="~/images/Doctors/@d.Image"
                             class="card-img-top"
                             style="height:280px; width:100%; object-fit:cover; object-position:center 20%;" />
                        <div class="card-body">
                            <h5>@d.Name</h5>
                            <p class="text-muted">@d.Specialization</p>
                            <a asp-controller="Appointments" asp-action="Book" asp-route-doctorId="@d.Id" class="btn btn-success">Book Appointment</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-warning">No doctors found.</div>
        }

    </div>
    @if ((int)ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-name="@ViewBag.Name"
                       asp-route-specialization="@ViewBag.Specialization">@i</a>
                </li>
            }
        </ul>
    </nav>
}
</div>